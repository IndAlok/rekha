DATABASE_URL=sqlite+pysqlite:////tmp/rekha.db
REKHA_ENV=dev
REKHA_TIMEZONE=Asia/Kolkata
RAZORPAY_WEBHOOK_SECRET=
OPS_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional live advisor. Leave the key empty for eval and CI.
# Names stay OPENAI_* because the client is OpenAI-shaped. Host is Groq.
# If this model 400s, the API tries llama-3.1-8b-instant, then the playbook.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
COMMS_ADAPTER=file
PAYMENT_LINK_BUDGET=30
CORS_ORIGINS=*
AUTO_EVAL_ON_BOOT=true
PAYMENTS_ADAPTER=sandbox
